; The concept lab binary: the .t cram tests run ./lab.exe, which links THIS concept's library —
; so the tests are RED until you fill this directory's TODO holes (the phase binary swiftml2
; links the phase's final concept and would not see your work here).
(executable
 (name lab)
 (modules lab)
 (libraries swiftml_types)
 (flags
  (:standard -warn-error -a)))

(cram
 (deps lab.exe oracle-corpus.txt))

(tests
 (names test_parser test_sema test_types test_units)
 (modules test_parser test_sema test_types test_units)
 (libraries alcotest swiftml_types)
 (flags
  (:standard -warn-error -a)))

; The §6 EXERCISE tests. They run under `make lab`, but each group probes whether you have
; started that exercise: untouched groups report as not started, and the runner shows them as
; `TODO (optional)` — so they can never make `make lab` red, and are never forgotten either.
(test
 (name test_exercises)
 (modules test_exercises)
 (libraries alcotest swiftml_types)
 (flags
  (:standard -warn-error -a)))

; …and a focused alias for working on them alone: make exercises C=phase2-types-flow/05-types-inference
(rule
 (alias exercises)
 (action
  (run ./test_exercises.exe)))
