; The concept lab binary: the .t cram tests run ./lab.exe, which links THIS concept's library —
; so the tests are RED until you fill this directory's TODO holes (the phase binary swiftml2
; links the phase's final concept and would not see your work here).
(executable
 (name lab)
 (modules lab)
 (libraries swiftml_flow)
 (flags
  (:standard -warn-error -a)))

(cram
 (deps lab.exe oracle-corpus.txt))

(tests
 (names test_parser test_sema)
 (modules test_parser test_sema)
 (libraries alcotest unix swiftml_flow)
 (flags
  (:standard -warn-error -a)))

(test
 (name test_exercises)
 (modules test_exercises)
 (libraries alcotest exercise_tests swiftml_flow)
 (flags
  (:standard -warn-error -a)))

(rule
 (alias exercises)
 (action (run ./test_exercises.exe)))
