; The concept lab binary: the .t cram tests run ./lab.exe, which links THIS concept's library —
; so the tests are RED until you fill this directory's TODO holes (the phase binary swiftml2
; links the phase's final concept and would not see your work here).
(executable
 (name lab)
 (modules lab canon)
 (libraries swiftml_sil)
 (flags
  (:standard -warn-error -a)))

(cram
 (deps
  lab.exe
  oracle-corpus.txt
  %{project_root}/tests/programs/controlflow.swift
  %{project_root}/tests/programs/if.swift))

(tests
 (names test_silgen test_canon)
 (modules test_silgen test_canon canon)
 (libraries alcotest swiftml_sil)
 (flags
  (:standard -warn-error -a)))

(test
 (name test_exercises)
 (modules test_exercises)
 (libraries alcotest exercise_tests swiftml_sil)
 (deps lab.exe)
 (flags
  (:standard -warn-error -a)))

(rule
 (alias exercises)
 (deps lab.exe)
 (action (run ./test_exercises.exe)))
