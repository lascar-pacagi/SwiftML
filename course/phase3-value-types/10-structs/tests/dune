; The concept lab binary: the .t cram tests run ./lab.exe, which links THIS concept's library —
; so the tests are RED until you fill this directory's TODO holes (the phase binary swiftml3
; links the phase's final concept and would not see your work here).
(executable
 (name lab)
 (modules lab)
 (libraries swiftml_structs)
 (flags
  (:standard -warn-error -a)))

(cram
 (deps lab.exe oracle-corpus.txt typecheck-corpus.txt timeout.py))

(executable
 (name test_structs)
 (modules test_structs)
 (libraries alcotest swiftml_structs)
 (flags
  (:standard -warn-error -a)))

; A non-advancing parser recovery branch must fail the lab instead of hanging it.
(rule
 (alias runtest)
 (deps test_structs.exe timeout.py)
 (action (run python3 timeout.py 15 %{exe:test_structs.exe})))

(test
 (name test_exercises)
 (modules test_exercises)
 (libraries alcotest exercise_tests)
 (deps lab.exe)
 (flags
  (:standard -warn-error -a)))

(rule
 (alias exercises)
 (deps lab.exe)
 (action (run ./test_exercises.exe)))
