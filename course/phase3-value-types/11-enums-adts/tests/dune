; The concept lab binary: the .t cram tests run ./lab.exe, which links THIS concept's library —
; so the tests are RED until you fill this directory's TODO holes (the phase binary swiftml3
; links the phase's final concept and would not see your work here).
(executable
 (name lab)
 (modules lab)
 (libraries swiftml_enums)
 (flags
  (:standard -warn-error -a)))

(cram
 (applies_to lexer-enums)
 (deps lab.exe timeout.py))

; Run each compiler stage only after the preceding stage is green. Besides making
; progress easier to read, this prevents a parser loop from delaying every lowering test.
(cram
 (applies_to parser-enum-decls parser-enum-uses)
 (runtest_alias false)
 (deps lab.exe timeout.py))

(cram
 (applies_to sema-enum-decls sema-enum-cases sema-enum-observation)
 (runtest_alias false)
 (deps lab.exe timeout.py))

(cram
 (applies_to silgen-case silgen-payload silgen-rawvalue)
 (runtest_alias false)
 (deps lab.exe timeout.py))

(cram
 (applies_to irgen-enums)
 (runtest_alias false)
 (deps lab.exe timeout.py))

(cram
 (applies_to oracle)
 (runtest_alias false)
 (deps lab.exe oracle-corpus.txt typecheck-corpus.txt timeout.py))

(executable
 (name test_enums)
 (modules test_enums)
 (libraries alcotest swiftml_enums)
 (flags
  (:standard -warn-error -a)))

; The unit suite runs WITH the stage it covers, filtered to that stage's groups, instead of once
; at the end: a case that passes while a LATER stage is still a TODO is then visible, rather than
; skipped behind the stage it is meant to report progress on. The timeout keeps a non-advancing
; parser recovery branch failing the lab instead of hanging it.
(rule
 (alias parser)
 (deps test_enums.exe timeout.py)
 (action (run python3 timeout.py 3 %{exe:test_enums.exe} test "(lexer|parser)-.*")))

(rule
 (alias sema)
 (deps test_enums.exe timeout.py)
 (action (run python3 timeout.py 3 %{exe:test_enums.exe} test "sema-.*")))

(rule
 (alias silgen)
 (deps test_enums.exe timeout.py)
 (action (run python3 timeout.py 3 %{exe:test_enums.exe} test "silgen-.*")))

(rule
 (alias irgen)
 (deps test_enums.exe timeout.py)
 (action (run python3 timeout.py 3 %{exe:test_enums.exe} test "irgen-.*")))
