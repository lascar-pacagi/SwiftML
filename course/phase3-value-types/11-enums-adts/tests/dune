; The concept lab binary: the .t cram tests run ./lab.exe, which links THIS concept's library —
; so the tests are RED until you fill this directory's TODO holes (the phase binary swiftml3
; links the phase's final concept and would not see your work here).
(executable
 (name lab)
 (modules lab)
 (libraries swiftml_enums)
 (flags
  (:standard -warn-error -a)))

(cram
 (deps lab.exe oracle-corpus.txt typecheck-corpus.txt timeout.py))

(executable
 (name test_enums)
 (modules test_enums)
 (libraries alcotest swiftml_enums)
 (flags
  (:standard -warn-error -a)))

; A non-advancing parser recovery branch must fail the lab instead of hanging it.
(rule
 (alias runtest)
 (deps test_enums.exe timeout.py)
 (action (run python3 timeout.py 15 %{exe:test_enums.exe})))
