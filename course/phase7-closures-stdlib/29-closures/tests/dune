; The concept lab binary: the .t cram tests run ./lab.exe, which links THIS concept's library —
; so the tests are RED until you fill this directory's TODO holes.
(executable
 (name lab)
 (modules lab)
 (libraries swiftml_closures)
 (flags
  (:standard -warn-error -a)))

(cram
 (deps lab.exe oracle-corpus.txt typecheck-corpus.txt))

(tests
 (names test_closures)
 (modules test_closures)
 (libraries alcotest swiftml_closures)
 (flags
  (:standard -warn-error -a)))
