; The lab binary the cram tests call — built from THIS concept's library.
(executable
 (name lab)
 (modules lab)
 (libraries swiftml_sema)
 (flags
  (:standard -warn-error -a)))

(cram
 (deps lab.exe oracle-corpus.txt))

; Alcotest unit tests for sema — assert exact diagnostic messages in-process.
(test
 (name test_sema)
 (modules test_sema)
 (libraries alcotest swiftml_sema)
 (flags
  (:standard -warn-error -a)))

; The §6 EXERCISE tests. They run under `make lab` too, but each group probes whether you
; have started that exercise and reports "skipped" if not.
;   make exercises C=phase1-minimal/03-sema
(executable
 (name test_exercises)
 (modules test_exercises)
 (libraries alcotest swiftml_sema)
 (flags
  (:standard -warn-error -a)))

(rule
 (alias exercises)
 (action
  (run ./test_exercises.exe)))

(rule
 (alias runtest)
 (action
  (run ./test_exercises.exe)))
