; Concept 01 — the lexer stage, as its own library.
; Modules: token (contract) · diagnostics (contract) · lexer (you implement).
; `wrapped false` keeps module names global (Token, Lexer, …) so later stages refer to
; them unqualified — the compiler is assembled stage by stage.
(library
 (name swiftml_lexer)
 (wrapped false)
 (flags
  (:standard -warn-error -a)))

; Don't compile the answer-key copies in solution/ into the library.
(dirs :standard \ solution)
