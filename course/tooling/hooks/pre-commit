#!/usr/bin/env bash
# Keep learner solutions out of the course repo.
#
# You edit skeletons in place, so your solutions live as uncommitted changes. Tell the
# repo which files are yours with `make claim C=<concept-dir>`; this hook then refuses to
# commit them. Course corrections that land inside a claimed file are the one exception —
# stage just those hunks (`git add -p`) and commit with SKELETON_FIX=1.
#
#   install:  make setup-hooks
#   bypass:   SKELETON_FIX=1 git commit ...   (or --no-verify)
set -uo pipefail

root="$(git rev-parse --show-toplevel)"
mine="$root/course/work/.mine"
[ -f "$mine" ] || exit 0
[ "${SKELETON_FIX:-0}" = "1" ] && exit 0

blocked=()
while IFS= read -r path; do
  grep -Fxq "$path" "$mine" && blocked+=("$path")
done < <(git diff --cached --name-only --diff-filter=ACM)

[ ${#blocked[@]} -eq 0 ] && exit 0

echo "pre-commit: these are files you claimed as your own work:"
printf '  %s\n' "${blocked[@]}"
cat <<'MSG'

Nothing was committed. Options:
  git restore --staged <file>        keep your work out of this commit
  git add -p <file> && SKELETON_FIX=1 git commit
                                     commit only a correction to the GIVEN part
  make save                          snapshot your work into course/work/ (gitignored)
  make unclaim C=<dir>               stop guarding a concept
MSG
exit 1
